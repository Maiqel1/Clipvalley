rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Deliberately NO public read rule. `allow read: if resource.data.isPublic`
    // would let anyone list every public clip in the database. Share pages read
    // by slug through the Admin SDK instead, which bypasses these rules.
    match /clips/{clipId} {
      allow read: if owns(resource.data.userId);
      allow create: if owns(request.resource.data.userId)
                    && request.resource.data.type in ['text', 'image', 'file']
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 100000
                    && (request.resource.data.type != 'file'
                        || request.resource.data.fileName is string);
      allow update: if owns(resource.data.userId)
                    && owns(request.resource.data.userId);
      allow delete: if owns(resource.data.userId);
    }

    match /profiles/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
                            && request.resource.data.username is string
                            && request.resource.data.username.matches('^[A-Za-z0-9_]{3,24}$');
      allow delete: if false;
    }

    // Uniqueness locks are written only by the Admin SDK, inside a transaction.
    match /usernames/{name} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
