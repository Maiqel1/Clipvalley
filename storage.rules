rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Path layout is {uid}/{clipId}.{ext}, so the first segment is the owner.
    match /{userId}/{file} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Any content type: files as well as images. The {userId} path prefix is
      // what enforces ownership; the size cap is the only limit a client
      // cannot bypass, so it is the real control.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size <= 25 * 1024 * 1024;

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
